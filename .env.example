# Copia este archivo a .env y personaliza los valores.
# Nunca subas el archivo .env al repositorio.

# Motor por defecto. PostgreSQL es el requisito académico.
# sqlite solo se admite con justificación técnica documentada.
DB_ENGINE=postgresql

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce_course
DB_USER=postgres
DB_PASSWORD=change_me

# Ruta opcional si el equipo usa SQLite de forma excepcional y justificada.
# DB_SQLITE_PATH=data/processed/ecommerce_course.sqlite

# Docker Compose / pgAdmin (solo desarrollo local, no son cuentas reales)
PGADMIN_DEFAULT_EMAIL=dev@local.test
PGADMIN_DEFAULT_PASSWORD=change_me
PGADMIN_PORT=5050

# Semilla y perfil de datos (uso del profesorado / generación local)
DATA_PROFILE=demo
DATA_SEED=2026
DATA_OUTPUT_DIR=data/raw
